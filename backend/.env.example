# MongoDB Atlas connection string (leave empty for in-memory fallback)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name
DB_NAME=Simly_Orbis

# AI Provider Configuration for Dr. Orbis (Mentor & Tutor)
# Precedence: GEMINI_API_KEY (if set) -> ANTHROPIC_API_KEY (if set) -> Rule-based fallback
# Both keys are optional. If neither is set, Dr. Orbis runs in offline rule-based mode.

# Google Gemini (Default AI provider)
GEMINI_API_KEY=
# Gemini model name must match config.py (default: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# Anthropic Claude (Secondary AI provider)
ANTHROPIC_API_KEY=
# Anthropic model name (default: claude-haiku-4-5-20251001)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# RC1 Hardening & Abuse Protection
TRUST_PROXY=false
AI_ENABLED=true
MENTOR_DAILY_CAP=300
ALLOWED_ORIGINS=*
