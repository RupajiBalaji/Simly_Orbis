# MongoDB Atlas connection string (leave empty for in-memory fallback)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name
DB_NAME=Simly_Orbis

# AI Provider Configuration for Dr. Orbis (Mentor & Tutor)
# Google Gemini is the AI provider. If unset, Dr. Orbis runs in offline rule-based mode.

# Google Gemini API Key
GEMINI_API_KEY=
# Gemini model name (default: gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# RC1 Hardening & Abuse Protection
TRUST_PROXY=false
AI_ENABLED=true
MENTOR_DAILY_CAP=300
ALLOWED_ORIGINS=*
